# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=expense_voucher_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# File upload
UPLOAD_DIR=uploads/signatures
MAX_FILE_SIZE_MB=2

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
